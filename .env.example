# Copia este archivo como .env (Copy-Item .env.example .env) y cambia las claves.
# .env está en .gitignore: no lo subas al repositorio.
# Los valores de abajo son de DESARROLLO LOCAL. Las bases solo escuchan en 127.0.0.1.

# --- API ---
# Puerto en la máquina (y dentro del contenedor). El túnel apunta aquí.
API_PORT=3000
# Opcionales: por defecto la API usa 127.0.0.1 y los puertos de abajo. El Compose los define solo.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5433
# MONGO_HOST=127.0.0.1
# MONGO_PORT=27017
# NEO4J_URI=bolt://127.0.0.1:7687

# --- Versiones fijadas (ver db/README.md) ---
POSTGRES_VERSION=18.7
MONGO_VERSION=9.0.4
NEO4J_VERSION=5.26.34-community

# --- PostgreSQL ---
POSTGRES_USER=dlbp
POSTGRES_PASSWORD=cambia-esta-clave-pg
POSTGRES_DB=dlbp
# 5432 suele estar ocupado por un PostgreSQL local de Windows; por eso 5433.
POSTGRES_HOST_PORT=5433

# --- MongoDB ---
MONGO_USER=dlbp
MONGO_PASSWORD=cambia-esta-clave-mongo
MONGO_DB=dlbp
MONGO_HOST_PORT=27017

# --- Neo4j (la contraseña debe tener al menos 8 caracteres) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambia-esta-clave-neo4j
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687

# --- Solo en el servidor (deploy/): las crea deploy/generar-env.sh ---
# DOMINIO=3-90-1-2.sslip.io
# CADDY_VERSION=2.11.9
# CLAVE_SEMILLA=contrasena-nueva-de-los-usuarios-de-ejemplo
