  "resenas": [
    { "id": "d1000000-0000-4000-8000-000000000001", "usuario": "c1000000-0000-4000-8000-000000000002", "obra": "b1000000-0000-4000-8000-000000000001", "calificacion": 5, "texto": "Una obra maestra de la ciencia ficción: política, religión y ecología en un solo desierto.", "oculta": false, "creado_en": "2026-11-03T18:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000002", "usuario": "c1000000-0000-4000-8000-000000000004", "obra": "b1000000-0000-4000-8000-000000000001", "calificacion": 4, "texto": "Denso al principio, pero la segunda mitad lo compensa.", "oculta": false, "creado_en": "2026-11-05T20:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000003", "usuario": "c1000000-0000-4000-8000-000000000005", "obra": "b1000000-0000-4000-8000-000000000001", "calificacion": 4, "texto": "Imprescindible, aunque el final llega de golpe.", "oculta": false, "creado_en": "2026-11-06T21:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000004", "usuario": "c1000000-0000-4000-8000-000000000002", "obra": "b1000000-0000-4000-8000-000000000003", "calificacion": 4, "texto": "Divertido y muy riguroso. Watney tiene mucha personalidad.", "oculta": false, "creado_en": "2026-11-04T19:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000005", "usuario": "c1000000-0000-4000-8000-000000000007", "obra": "b1000000-0000-4000-8000-000000000003", "calificacion": 5, "texto": "No pude soltarlo. Ciencia y humor a partes iguales.", "oculta": false, "creado_en": "2026-11-07T22:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000006", "usuario": "c1000000-0000-4000-8000-000000000005", "obra": "b1000000-0000-4000-8000-000000000004", "calificacion": 5, "texto": "Un relato breve que cambia cómo se piensa el tiempo.", "oculta": false, "creado_en": "2026-11-08T17:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000007", "usuario": "c1000000-0000-4000-8000-000000000003", "obra": "b1000000-0000-4000-8000-000000000005", "calificacion": 5, "texto": "Más tenso y más oscuro que la película.", "oculta": false, "creado_en": "2026-11-02T16:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000008", "usuario": "c1000000-0000-4000-8000-000000000007", "obra": "b1000000-0000-4000-8000-000000000005", "calificacion": 4, "texto": "Muy entretenido; la parte técnica se hace larga.", "oculta": false, "creado_en": "2026-11-09T18:30:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000009", "usuario": "c1000000-0000-4000-8000-000000000002", "obra": "b1000000-0000-4000-8000-000000000006", "calificacion": 3, "texto": "Agradable, pero esperaba más de la aventura.", "oculta": false, "creado_en": "2026-11-04T21:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000010", "usuario": "c1000000-0000-4000-8000-000000000004", "obra": "b1000000-0000-4000-8000-000000000008", "calificacion": 4, "texto": "Ingenioso y mordaz; los diálogos siguen funcionando.", "oculta": false, "creado_en": "2026-11-10T19:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000011", "usuario": "c1000000-0000-4000-8000-000000000002", "obra": "b1000000-0000-4000-8000-000000000009", "calificacion": 5, "texto": "Cuidado: este comentario revela el final de la novela.", "oculta": true, "creado_en": "2026-11-11T20:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000012", "usuario": "c1000000-0000-4000-8000-000000000008", "obra": "b1000000-0000-4000-8000-000000000009", "calificacion": 2, "texto": "Bien escrito, pero frío y previsible.", "oculta": false, "creado_en": "2026-11-12T20:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000013", "usuario": "c1000000-0000-4000-8000-000000000006", "obra": "f1000000-0000-4000-8000-000000000001", "calificacion": 4, "texto": "Visualmente impresionante.", "oculta": false, "creado_en": "2026-11-13T21:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000014", "usuario": "c1000000-0000-4000-8000-000000000004", "obra": "f1000000-0000-4000-8000-000000000001", "calificacion": 3, "texto": "Bella, pero deja fuera mucho de la política del libro.", "oculta": false, "creado_en": "2026-11-14T22:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000015", "usuario": "c1000000-0000-4000-8000-000000000003", "obra": "f1000000-0000-4000-8000-000000000006", "calificacion": 4, "texto": "Sigue siendo una gran película de aventuras.", "oculta": false, "creado_en": "2026-11-15T20:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000016", "usuario": "c1000000-0000-4000-8000-000000000007", "obra": "f1000000-0000-4000-8000-000000000004", "calificacion": 4, "texto": "Fiel al tono del libro.", "oculta": false, "creado_en": "2026-11-16T21:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000017", "usuario": "c1000000-0000-4000-8000-000000000002", "obra": "f1000000-0000-4000-8000-000000000009", "calificacion": 5, "texto": "Una adaptación con mucha atmósfera.", "oculta": false, "creado_en": "2026-11-17T20:00:00Z" },
    { "id": "d1000000-0000-4000-8000-000000000018", "usuario": "c1000000-0000-4000-8000-000000000008", "obra": "f1000000-0000-4000-8000-000000000010", "calificacion": 3, "texto": "La primera mitad es mejor que la segunda.", "oculta": false, "creado_en": "2026-11-18T20:00:00Z" }
  ],

